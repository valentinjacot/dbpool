# ---- Postgres ----
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_MONITOR_USER=appd_monitor
POSTGRES_MONITOR_PASSWORD=appd_monitor_pass

# ---- Observability (Phase 1 dashboard, no AppD) ----
GRAFANA_ADMIN_PASSWORD=admin
# Non-default host ports so this stack doesn't clash with other local
# Grafana/Prometheus setups (e.g. another project's docker-compose).
GRAFANA_HOST_PORT=3001
PROMETHEUS_HOST_PORT=9091

# ---- Phase 2: AppDynamics controller (not needed in Phase 1) ----
AGENT_ENABLED=false
CONTROLLER_HOST=
CONTROLLER_PORT=443
SSL_ENABLED=true
ACCOUNT_NAME=
ACCOUNT_ACCESS_KEY=
APPD_APPLICATION_NAME=AFI-UC3-Demo

# ---- Phase 3: 5-service topology ----
# Per-JVM heap cap - 5 instrumented services + Postgres + DB/Machine agent
# is heavy on a small laptop. Applies to all 5 app services.
JAVA_MAX_HEAP=256m
# How often the always-on reporting load hits reporting directly (used by
# loadtest/normal.js, overload.js, overload.sh). Keep low: its only job is
# to prove the DB serves a second consumer fine, not to add load.
REPORTING_RATE_PER_MIN=3
