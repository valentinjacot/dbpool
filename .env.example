# ---- Postgres ----
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_MONITOR_USER=appd_monitor
POSTGRES_MONITOR_PASSWORD=appd_monitor_pass

# ---- Observability (Phase 1 dashboard, no AppD) ----
GRAFANA_ADMIN_PASSWORD=admin
# Non-default host ports so this stack doesn't clash with other local
# Grafana/Prometheus setups (e.g. another project's docker-compose).
GRAFANA_HOST_PORT=3001
PROMETHEUS_HOST_PORT=9091

# ---- Phase 2: AppDynamics controller (not needed in Phase 1) ----
AGENT_ENABLED=false
CONTROLLER_HOST=
CONTROLLER_PORT=443
SSL_ENABLED=true
ACCOUNT_NAME=
ACCOUNT_ACCESS_KEY=
APPD_APPLICATION_NAME=AFI-UC3-Demo
